---
interface Props {
  href: string
  variant?: 'primary' | 'secondary' | 'outline'
  class?: string
  ariaLabel?: string
  title?: string
}

const { href, variant = 'primary', class: className = '', ariaLabel, title } = Astro.props

const variantClass = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  outline: 'btn-outline',
}[variant]

const baseClasses =
  'inline-flex items-center justify-center gap-2 transition-all duration-150 min-h-[44px] min-w-[44px] touch-manipulation'
---
<a
  href={href}
  class={`${baseClasses} ${variantClass} ${className}`}
  aria-label={ariaLabel}
  title={title}
>
  <slot />
</a>
