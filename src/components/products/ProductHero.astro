---
import type { ProductContent } from '../../types/products'

interface Props { product: ProductContent }
const { product } = Astro.props
const isBlue = product.accent === 'blue'
const accent = isBlue ? 'text-[#3FA9F5]' : 'text-[#2FBF71]'
const badge = isBlue ? 'border-[#3FA9F5]/25 bg-[#3FA9F5]/10 text-[#3FA9F5]' : 'border-[#2FBF71]/25 bg-[#2FBF71]/10 text-[#2FBF71]'
---
<section class="relative overflow-hidden bg-white pb-14 pt-28 sm:pb-20 sm:pt-32">
  <div aria-hidden="true" class={`pointer-events-none absolute inset-0 opacity-60 ${isBlue ? 'pattern-grid' : 'pattern-dots'}`}></div>
  <div class="section-inner relative grid items-center gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
    <div>
      <span class={`inline-flex rounded-full border px-3 py-1 text-xs font-semibold ${badge}`}>Acceso anticipado</span>
      <p class={`mt-6 text-sm font-semibold uppercase tracking-[0.16em] ${accent}`}>{product.name}</p>
      <h1 class="mt-3 text-4xl font-bold leading-[1.1] tracking-tight text-[#0B2A3C] sm:text-5xl lg:text-6xl">{product.headline}</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#6F7A83] sm:text-xl">{product.subheadline}</p>
      {product.supportLine && <p class="mt-4 font-semibold text-[#0B2A3C]">{product.supportLine}</p>}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={product.contactHref} class="btn-primary w-full sm:w-auto" data-analytics="product_demo_click" data-product={product.id}>Solicitar demo <span aria-hidden="true">→</span></a>
        <a href="#como-funciona" class="btn-outline w-full sm:w-auto" data-analytics="product_secondary_cta_click" data-product={product.id}>Ver cómo funciona</a>
      </div>
    </div>
    <figure class="overflow-hidden rounded-[var(--radius-lg)] border border-[rgba(11,42,60,0.12)] bg-white shadow-[0_24px_60px_-30px_rgba(11,42,60,0.45)]">
      <img src={product.heroImage.src} alt={product.heroImage.alt} width={product.heroImage.width} height={product.heroImage.height} class="h-auto w-full" fetchpriority="high" />
    </figure>
  </div>
</section>
