---
import type { ProductContent } from '../../types/products'
import ProductHero from './ProductHero.astro'
import ProductWorkflow from './ProductWorkflow.astro'
import ProductFeatureSection from './ProductFeatureSection.astro'
import ProductScenario from './ProductScenario.astro'
import ProductCTA from './ProductCTA.astro'
import Section from '../ui/Section.astro'
import Card from '../ui/Card.astro'

interface Props { product: ProductContent }
const { product } = Astro.props
const isBlue = product.accent === 'blue'
---
<ProductHero product={product} />
<Section variant="white">
  <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <p class={`text-sm font-semibold uppercase tracking-[0.16em] ${isBlue ? 'text-[#3FA9F5]' : 'text-[#2FBF71]'}`}>Pensado para</p>
      <p class="mt-4 text-xl font-semibold leading-snug text-[#0B2A3C]">{product.audience}</p>
    </div>
    <div>
      <h2 class="text-3xl font-bold leading-tight text-[#0B2A3C] sm:text-4xl">{product.problemTitle}</h2>
      <p class="mt-5 text-lg leading-relaxed text-[#6F7A83]">{product.problemText}</p>
    </div>
  </div>
  <div class="mt-12 grid gap-5 md:grid-cols-3">
    {product.benefits.map((benefit, index) => (
      <Card class="p-6">
        <span class={`text-sm font-bold ${isBlue ? 'text-[#3FA9F5]' : 'text-[#2FBF71]'}`}>0{index + 1}</span>
        <p class="mt-4 text-lg font-semibold leading-snug text-[#0B2A3C]">{benefit}</p>
      </Card>
    ))}
  </div>
</Section>
<ProductWorkflow product={product} />
<ProductFeatureSection product={product} />
<ProductScenario product={product} />
<Section variant="white">
  <div class="mx-auto max-w-[900px]">
    <h2 class="text-center text-3xl font-bold text-[#0B2A3C] sm:text-4xl">Insights relacionados</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {product.insights.map((insight) => (
        <a href={insight.href} class="card-flat group flex items-center justify-between gap-4 hover:border-[#2FBF71] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2A3C] focus-visible:ring-offset-2">
          <span class="font-semibold text-[#0B2A3C]">{insight.title}</span>
          <span class="text-[#2FBF71]" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</Section>
<ProductCTA product={product} />
