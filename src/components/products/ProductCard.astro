---
import type { ProductContent } from '../../types/products'

interface Props {
  product: ProductContent
}

const { product } = Astro.props
const isBlue = product.accent === 'blue'
const accent = isBlue ? 'text-[#3FA9F5]' : 'text-[#2FBF71]'
const accentBg = isBlue ? 'bg-[#3FA9F5]/10 border-[#3FA9F5]/25' : 'bg-[#2FBF71]/10 border-[#2FBF71]/25'
---
<article class={`card-flat flex h-full flex-col border-t-4 ${isBlue ? 'border-t-[#3FA9F5]' : 'border-t-[#2FBF71]'}`}>
  <div class="mb-5 flex items-center justify-between gap-4">
    <span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold ${accentBg} ${accent}`}>
      Acceso anticipado
    </span>
    <span class={`text-sm font-semibold ${accent}`}>{isBlue ? 'CRM' : 'Portafolio'}</span>
  </div>
  <h3 class="text-2xl font-bold text-[#0B2A3C]">{product.name}</h3>
  <p class="mt-3 text-lg font-medium leading-snug text-[#0B2A3C]">{product.shortHeadline}</p>
  <p class="mt-4 text-sm leading-relaxed text-[#6F7A83]">{product.audience}</p>
  <ul class="mt-6 space-y-3 text-sm text-[#0B2A3C]">
    {product.benefits.map((benefit) => (
      <li class="flex gap-3">
        <span class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${isBlue ? 'bg-[#3FA9F5]' : 'bg-[#2FBF71]'}`}></span>
        <span>{benefit}</span>
      </li>
    ))}
  </ul>
  <div class="mt-8 flex flex-wrap gap-4">
    <a href={product.href} class={`font-semibold ${accent} hover:text-[#0B2A3C] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2A3C] focus-visible:ring-offset-2 rounded`} data-analytics="product_card_cta_click" data-product={product.id}>
      Ver producto <span aria-hidden="true">→</span>
    </a>
    <a href={product.contactHref} class="font-semibold text-[#0B2A3C] underline decoration-[#0B2A3C]/30 underline-offset-4 hover:text-[#2FBF71] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2A3C] focus-visible:ring-offset-2 rounded" data-analytics="product_demo_click" data-product={product.id}>
      Solicitar demo
    </a>
  </div>
</article>
