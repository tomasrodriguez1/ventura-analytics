---
import type { ProductContent } from '../../types/products'
import Section from '../ui/Section.astro'

interface Props { product: ProductContent }
const { product } = Astro.props
const isBlue = product.accent === 'blue'
const accent = isBlue ? 'bg-[#3FA9F5] text-white' : 'bg-[#2FBF71] text-white'
---
<Section variant="gray" id="como-funciona" class="scroll-mt-20">
  <div class="mx-auto max-w-[850px] text-center">
    <h2 class="text-3xl font-bold text-[#0B2A3C] sm:text-4xl">{product.workflowTitle}</h2>
    <p class="mt-5 text-lg leading-relaxed text-[#6F7A83]">{product.workflowDescription}</p>
  </div>
  <ol class="mx-auto mt-10 grid max-w-[1100px] gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {product.workflow.map((step, index) => (
      <li class="relative card-flat flex min-h-36 items-center gap-4 p-5">
        <span class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-bold ${accent}`}>{index + 1}</span>
        <span class="font-semibold leading-snug text-[#0B2A3C]">{step}</span>
      </li>
    ))}
  </ol>
</Section>
