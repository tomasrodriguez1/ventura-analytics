---
import LogoLockup from './LogoLockup.astro'
import { LINKS } from '../lib/constants'

interface Props {
  extraLink?: { href: string; label: string }
}

const { extraLink } = Astro.props
const pathname = Astro.url.pathname
const isHome = pathname === '/' || pathname === ''
const isBlog = pathname.startsWith('/blog')
const isProducts = pathname.startsWith('/productos')
const navItems = [
  { href: LINKS.home, label: 'Inicio', active: isHome },
  { href: LINKS.products, label: 'Productos', active: isProducts },
  { href: LINKS.blog, label: 'Blog', active: isBlog },
]
---
<nav class="fixed left-0 right-0 top-0 z-50 border-b border-[rgba(11,42,60,0.08)] bg-white/95 backdrop-blur-md" aria-label="Navegación principal">
  <div class="w-full px-4 sm:px-6 md:px-12 lg:px-16">
    <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between md:h-20">
      <LogoLockup size="sm" priority href={LINKS.home} class="flex-shrink-0" />
      <div class="hidden items-center gap-7 lg:flex">
        {navItems.map((item) => (
          <a href={item.href} class={`rounded text-sm font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2A3C] focus-visible:ring-offset-2 ${item.active ? 'text-[#0B2A3C]' : 'text-[#6F7A83] hover:text-[#0B2A3C]'}`} aria-current={item.active ? 'page' : undefined} data-analytics={item.label === 'Productos' ? 'product_nav_click' : undefined}>
            {item.label}
          </a>
        ))}
        {extraLink && <a href={extraLink.href} class="text-sm font-semibold text-[#0B2A3C] hover:text-[#2FBF71]">{extraLink.label}</a>}
        <a href={LINKS.contact} class="btn-primary px-5 py-2.5 text-sm" aria-label="Ir a página de contacto">Contacto</a>
      </div>
      <details id="mobile-menu" class="group relative lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded border border-[rgba(11,42,60,0.15)] text-[#0B2A3C] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2A3C] focus-visible:ring-offset-2">
          <svg class="h-5 w-5 group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <svg class="hidden h-5 w-5 group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          <span class="sr-only">Abrir menú</span>
        </summary>
        <div class="absolute right-0 mt-3 w-72 rounded-[var(--radius-lg)] border border-[rgba(11,42,60,0.12)] bg-white p-3 shadow-xl">
          <div class="space-y-1">
            {navItems.map((item) => <a href={item.href} class={`block rounded px-4 py-3 text-sm font-semibold focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0B2A3C] ${item.active ? 'bg-gray-50 text-[#0B2A3C]' : 'text-[#6F7A83] hover:bg-gray-50 hover:text-[#0B2A3C]'}`} aria-current={item.active ? 'page' : undefined} data-analytics={item.label === 'Productos' ? 'product_nav_click' : undefined}>{item.label}</a>)}
          </div>
          <div class="mt-3 border-t border-[rgba(11,42,60,0.1)] pt-3">
            <p class="px-4 pb-2 text-xs font-semibold uppercase tracking-wider text-[#6F7A83]">Productos</p>
            <a href={LINKS.crm} class="block rounded px-4 py-2.5 text-sm text-[#0B2A3C] hover:bg-gray-50">CRM Zalantos</a>
            <a href={LINKS.projectManagement} class="block rounded px-4 py-2.5 text-sm text-[#0B2A3C] hover:bg-gray-50">Gestión de Proyectos</a>
          </div>
          <a href={LINKS.contact} class="btn-primary mt-4 w-full px-4 py-3 text-sm">Contacto</a>
        </div>
      </details>
    </div>
  </div>
</nav>
<script is:inline>
  const menu = document.getElementById('mobile-menu')
  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener('click', (event) => {
      if ((event.target).closest('a')) menu.open = false
    })
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false
    })
  }
</script>
