---
import Section from '../ui/Section.astro'
import LinkButton from '../ui/LinkButton.astro'
import AiCtaButton from '../ui/AiCtaButton.astro'
import { LINKS } from '../../lib/constants'

const DELIVERABLES = [
  'Claridad sobre tu problema real y sus causas raíz',
  'Opciones de solución concretas, alineadas a tu operación',
  'Próximos pasos y roadmap sugerido, sin compromiso',
]
---
<Section id="sprint-0" variant="gray">
  <div class="max-w-[1100px] mx-auto w-full space-y-10 md:space-y-12">
    <div class="flex flex-col lg:flex-row lg:items-center lg:gap-20 xl:gap-28">

      <div class="lg:flex-1 mb-14 lg:mb-0 lg:-translate-y-6 space-y-8 md:space-y-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#2FBF71]/10 border border-[#2FBF71]/20">
          <span class="w-2 h-2 rounded-full bg-[#2FBF71]" aria-hidden="true"></span>
          <span class="text-xs font-semibold text-[#2FBF71] uppercase tracking-wide">
            Sin costo · Sin compromiso
          </span>
        </div>

        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-[#0B2A3C] leading-tight">
          Prueba el Sprint&nbsp;0{' '}
          <span class="text-[#2FBF71]">(sin costo)</span>
        </h2>

        <p class="text-base sm:text-lg md:text-xl text-[#6F7A83] leading-relaxed max-w-lg">
          Una sesión de <strong class="text-[#0B2A3C]">1 hora</strong> para entender tu contexto
          y tu problema. Luego te entregamos un diagnóstico resumido y una propuesta con las opciones más adecuadas para tu negocio.
        </p>
      </div>

      <div class="lg:flex-1 space-y-8 md:space-y-10">
        <div class="mt-10 mb-4">
          <p class="text-sm sm:text-base font-semibold text-[#6F7A83] uppercase tracking-wider">
            Qué recibes
          </p>
        </div>
        <ul class="space-y-5 md:space-y-6">
          {DELIVERABLES.map((text) => (
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 text-[#2FBF71] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-[#0B2A3C] text-base sm:text-lg leading-snug">
                {text}
              </span>
            </li>
          ))}
        </ul>

        <div class="pt-2">
          <LinkButton
            href={LINKS.contact}
            variant="primary"
            class="w-full sm:w-auto shadow-lg shadow-[#0B2A3C]/10 hover:shadow-xl hover:shadow-[#0B2A3C]/20 transition-all duration-300"
          >
            Agenda tu Sprint 0
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </LinkButton>
        </div>
      </div>
    </div>

    <div class="text-center max-w-2xl mx-auto pt-2">
      <p class="text-sm sm:text-base text-[#6F7A83] leading-relaxed">
        Si todavía tienes dudas y no quieres agendar aún, consulta a nuestro Consultor IA para
        ordenar tu caso y explorar posibles caminos de solución.
      </p>
      <div class="mt-4 flex justify-center">
        <AiCtaButton
          href={LINKS.aiConsultant}
          variant="navbar"
          class="w-full sm:w-auto px-6 py-3 text-base"
        >
          Consultar con IA
        </AiCtaButton>
      </div>
    </div>
  </div>
</Section>
