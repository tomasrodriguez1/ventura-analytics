---
const product = Astro.url.searchParams.get('product')

const PRODUCT_COPY = {
  crm: {
    headline: 'Solicita una demo de CRM Zalantos',
    description:
      'Conoce cómo reunir pipeline, contexto de reuniones y propuestas de actualización con revisión humana antes de cada cambio.',
  },
  'gestion-proyectos': {
    headline: 'Solicita una demo de Gestión de Proyectos',
    description:
      'Conoce cómo tener clientes, avance y salud del portafolio en un solo sistema para tu consultora.',
  },
} as const

const DEFAULT_COPY = {
  hero: {
    headline: 'Agenda tu Sprint 0 Gratuitamente',
    description:
      'Una sesión de 1 hora para entender tu contexto y tu problema. Te entregamos un diagnóstico resumido y una propuesta con las opciones más adecuadas para tu negocio. Sin costo, sin compromiso.',
  },
  benefits: [
    'Claridad sobre tu problema real y sus causas raíz',
    'Opciones de solución concretas, alineadas a tu operación',
    'Próximos pasos y roadmap sugerido, sin compromiso',
  ],
}

const productCopy = product === 'crm' || product === 'gestion-proyectos' ? PRODUCT_COPY[product] : null
const COPY = {
  ...DEFAULT_COPY,
  hero: productCopy ?? DEFAULT_COPY.hero,
}
---
<section class="w-full bg-gray-50 py-16 sm:py-20 md:py-32" aria-labelledby="contact-heading">
  <div class="w-full px-4 sm:px-6 md:px-12 max-w-[1200px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <div class="space-y-6 md:space-y-8">
        <h2 id="contact-heading" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-[#0B2A3C] leading-[1.1] mb-6 md:mb-8">
          {COPY.hero.headline}
        </h2>

        <p id="contact-description" class="text-lg sm:text-xl text-[#6F7A83] leading-relaxed">
          {COPY.hero.description}
        </p>

        <ul class="space-y-4" role="list">
          {COPY.benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <svg
                class="w-6 h-6 text-[#2FBF71] flex-shrink-0 mt-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
              </svg>
              <span class="font-medium text-[#0B2A3C]">{benefit}</span>
            </li>
          ))}
        </ul>

        <p class="text-sm text-[#6F7A83] mt-4 border-t border-gray-200 pt-4">
          Al agendar deja el nombre de tu compañía y una breve descripción de lo que quieres resolver para que lleguemos preparados.
        </p>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
          <div
            class="calendly-inline-widget w-full"
            data-url="https://calendly.com/tomas-rodriguez-zalantos/30min?hide_event_type_details=1&hide_gdpr_banner=1&primary_color=058f2b"
            style="min-width:320px;height:700px"
          ></div>
        </div>
        <script
          type="text/javascript"
          src="https://assets.calendly.com/assets/external/widget.js"
          async
        ></script>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  const product = new URLSearchParams(window.location.search).get('product')
  const productCopy = {
    crm: {
      headline: 'Solicita una demo de CRM Zalantos',
      description: 'Conoce cómo reunir pipeline, contexto de reuniones y propuestas de actualización con revisión humana antes de cada cambio.',
    },
    'gestion-proyectos': {
      headline: 'Solicita una demo de Gestión de Proyectos',
      description: 'Conoce cómo tener clientes, avance y salud del portafolio en un solo sistema para tu consultora.',
    },
  }
  const copy = product ? productCopy[product] : null
  if (copy) {
    const heading = document.getElementById('contact-heading')
    const description = document.getElementById('contact-description')
    if (heading) heading.textContent = copy.headline
    if (description) description.textContent = copy.description
  }
  window.addEventListener('message', (event) => {
    if (!event.data || event.data.event !== 'calendly.event_scheduled') return
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'demo_booking_completed', { product: product || 'general' })
    }
  })
</script>
