---
import Section from '../ui/Section.astro'
import ProductCard from '../products/ProductCard.astro'
import { products } from '../../data/products'
---
<Section variant="white" id="productos">
  <div class="mx-auto max-w-[760px] text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#3FA9F5]">Productos Zalantos</p>
    <h2 class="mt-3 text-3xl font-bold text-[#0B2A3C] sm:text-4xl md:text-5xl">Sistemas para avanzar con más control</h2>
    <p class="mt-5 text-base leading-relaxed text-[#6F7A83] sm:text-lg">Dos productos en acceso anticipado para ordenar la operación comercial y la entrega de proyectos.</p>
  </div>
  <div class="mx-auto mt-10 grid max-w-[1120px] gap-6 md:mt-14 md:grid-cols-2 md:gap-8">
    {products.map((product) => <ProductCard product={product} />)}
  </div>
</Section>
