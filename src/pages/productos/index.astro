---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Section from '../../components/ui/Section.astro'
import ProductCard from '../../components/products/ProductCard.astro'
import { products } from '../../data/products'
import { breadcrumbSchema } from '../../lib/schemas'

const title = 'Productos de software B2B'
const description = 'Productos Zalantos en acceso anticipado para equipos comerciales B2B y consultoras.'
const canonical = 'https://zalantos.com/productos/'
---
<BaseLayout title={title} description={description} canonical={canonical} extraSchemas={[breadcrumbSchema([
  { name: 'Inicio', url: 'https://zalantos.com/' },
  { name: 'Productos', url: canonical },
])]}>
  <main id="main-content" class="flex-grow pt-20">
    <Section variant="gray" hero>
      <div class="mx-auto max-w-[820px] text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#3FA9F5]">Productos Zalantos</p>
        <h1 class="mt-3 text-4xl font-bold leading-tight text-[#0B2A3C] sm:text-5xl">Software B2B para avanzar con más control</h1>
        <p class="mt-6 text-lg leading-relaxed text-[#6F7A83]">Conoce nuestros productos en acceso anticipado para ordenar el ciclo comercial y la entrega de proyectos.</p>
      </div>
    </Section>
    <Section variant="white">
      <div class="mx-auto grid max-w-[1120px] gap-6 md:grid-cols-2 md:gap-8">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </Section>
  </main>
</BaseLayout>
