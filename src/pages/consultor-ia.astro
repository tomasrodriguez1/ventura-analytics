---
import BaseLayout from '../layouts/BaseLayout.astro'
import ConsultorIAContent from '../components/chat/ConsultorIAContent'

const title = 'Consultor IA de Zalantos — Análisis y automatización'
const description =
  'Resuelve dudas sobre análisis de datos, IA y transformación digital con el Consultor IA de Zalantos. Respuestas claras y personalizadas para tu negocio.'
const canonical = 'https://zalantos.com/consultor-ia/'
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="website"
>
  <main class="min-h-screen">
    <ConsultorIAContent client:load />
  </main>
</BaseLayout>
